        <hasGender rdf:resource="http://example.org/greek-mythology-ontology#FemaleValue"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Leto"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Zeus"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/greek-mythology-ontology#Asteria -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Asteria">
        <rdf:type rdf:resource="http://example.org/greek-mythology-ontology#Titan"/>
        <hasGender rdf:resource="http://example.org/greek-mythology-ontology#FemaleValue"/>
