    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/greek-mythology-ontology#hasDomain -->

    <owl:DatatypeProperty rdf:about="http://example.org/greek-mythology-ontology#hasDomain">
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="id">punya ranah/personifikasi</rdfs:label>
    </owl:DatatypeProperty>
    


