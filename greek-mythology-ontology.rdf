    <!-- http://example.org/greek-mythology-ontology#Coeus -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Coeus">
        <rdf:type rdf:resource="http://example.org/greek-mythology-ontology#FirstGenerationTitan"/>
