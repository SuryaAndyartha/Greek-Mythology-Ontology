<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/greek-mythology-ontology#"
     xml:base="http://example.org/greek-mythology-ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:greek-mythology-ontology="http://example.org/greek-mythology-ontology#">
    <owl:Ontology rdf:about="http://example.org/greek-mythology-ontology">
        <rdfs:comment xml:lang="id">Dimodelkan dari bagan family tree mitologi Yunani. Hanya hasParent, hasPartner, hasSpouse, dan hasGender yang didefinisikan eksplisit; sisanya disimpulkan reasoner (Pellet).</rdfs:comment>
        <rdfs:label xml:lang="id">Ontologi Silsilah Dewa-Dewi Yunani</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/greek-mythology-ontology#hasAncestor -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasAncestor">
        <owl:inverseOf rdf:resource="http://example.org/greek-mythology-ontology#hasDescendant"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:label xml:lang="id">punya leluhur</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasAunt -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasAunt">
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#FemaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasParent"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSister"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya bibi</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasBrother -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasBrother">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasSibling"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MaleBeing"/>
        <rdfs:label xml:lang="id">punya saudara laki-laki</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasBrotherInLaw -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasBrotherInLaw">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasSiblingInLaw"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSibling"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasHusband"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSpouse"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasBrother"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya ipar laki-laki</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasChild -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasChild">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasDescendant"/>
        <owl:inverseOf rdf:resource="http://example.org/greek-mythology-ontology#hasParent"/>
        <rdfs:label xml:lang="id">punya anak</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasChildInLaw -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasChildInLaw">
        <owl:inverseOf rdf:resource="http://example.org/greek-mythology-ontology#hasParentInLaw"/>
        <rdfs:label xml:lang="id">punya menantu</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasCousin -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasCousin">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:label xml:lang="id">punya sepupu</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasDaughter -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasDaughter">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasChild"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#FemaleBeing"/>
        <rdfs:label xml:lang="id">punya anak perempuan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasDaughterInLaw -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasDaughterInLaw">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasChildInLaw"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#FemaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasChild"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasWife"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya menantu perempuan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasDescendant -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasDescendant">
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:label xml:lang="id">punya keturunan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasFather -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasFather">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasParent"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MaleBeing"/>
        <rdfs:label xml:lang="id">punya ayah</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasFatherInLaw -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasFatherInLaw">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasParentInLaw"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSpouse"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasFather"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya ayah mertua</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasGender -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasGender">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#Gender"/>
        <rdfs:label xml:lang="id">punya gender</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasGrandchild -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasGrandchild">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasDescendant"/>
        <owl:inverseOf rdf:resource="http://example.org/greek-mythology-ontology#hasGrandparent"/>
        <rdfs:label xml:lang="id">punya cucu</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasGranddaughter -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasGranddaughter">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasGrandchild"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#FemaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasChild"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasDaughter"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya cucu perempuan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasGrandfather -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasGrandfather">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasGrandparent"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasParent"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasFather"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya kakek</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasGrandmother -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasGrandmother">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasGrandparent"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#FemaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasParent"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasMother"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya nenek</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasGrandparent -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasGrandparent">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasAncestor"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasParent"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasParent"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya kakek/nenek</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasGrandson -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasGrandson">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasGrandchild"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasChild"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSon"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya cucu laki-laki</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasHusband -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasHusband">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasSpouse"/>
        <owl:inverseOf rdf:resource="http://example.org/greek-mythology-ontology#hasWife"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MaleBeing"/>
        <rdfs:label xml:lang="id">punya suami</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasMother -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasMother">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasParent"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#FemaleBeing"/>
        <rdfs:label xml:lang="id">punya ibu</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasMotherInLaw -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasMotherInLaw">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasParentInLaw"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#FemaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSpouse"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasMother"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya ibu mertua</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasNephew -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasNephew">
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSibling"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSon"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya keponakan laki-laki</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasNiece -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasNiece">
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#FemaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSibling"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasDaughter"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya keponakan perempuan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasParent -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasParent">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasAncestor"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:label xml:lang="id">punya orang tua</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasParentInLaw -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasParentInLaw">
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSpouse"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasParent"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya mertua</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasPartner -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasPartner">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:label xml:lang="id">punya pasangan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasSibling -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasSibling">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:label xml:lang="id">punya saudara</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasSiblingInLaw -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasSiblingInLaw">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSpouse"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSibling"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya ipar</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasSister -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasSister">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasSibling"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#FemaleBeing"/>
        <rdfs:label xml:lang="id">punya saudara perempuan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasSisterInLaw -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasSisterInLaw">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasSiblingInLaw"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#FemaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSibling"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasWife"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSpouse"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasSister"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya ipar perempuan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasSon -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasSon">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasChild"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MaleBeing"/>
        <rdfs:label xml:lang="id">punya anak laki-laki</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasSonInLaw -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasSonInLaw">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasChildInLaw"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasChild"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasHusband"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya menantu laki-laki</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasSpouse -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasSpouse">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasPartner"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:label xml:lang="id">punya pasangan sah/pernikahan</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasUncle -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasUncle">
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#MaleBeing"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasParent"/>
            <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#hasBrother"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="id">punya paman</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/greek-mythology-ontology#hasWife -->

    <owl:ObjectProperty rdf:about="http://example.org/greek-mythology-ontology#hasWife">
        <rdfs:subPropertyOf rdf:resource="http://example.org/greek-mythology-ontology#hasSpouse"/>
        <rdfs:domain rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:range rdf:resource="http://example.org/greek-mythology-ontology#FemaleBeing"/>
        <rdfs:label xml:lang="id">punya istri</rdfs:label>
    </owl:ObjectProperty>
    


