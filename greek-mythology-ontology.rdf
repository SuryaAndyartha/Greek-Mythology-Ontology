    <!-- http://example.org/greek-mythology-ontology#Aether -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Aether">
        <rdf:type rdf:resource="http://example.org/greek-mythology-ontology#PrimordialDeity"/>
        <hasGender rdf:resource="http://example.org/greek-mythology-ontology#MaleValue"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Erebus"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Nyx"/>
        <hasDomain>Heaven</hasDomain>
    </owl:NamedIndividual>
    


    <!-- http://example.org/greek-mythology-ontology#Alcmene -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Alcmene">
        <rdf:type rdf:resource="http://example.org/greek-mythology-ontology#Mortal"/>
        <hasGender rdf:resource="http://example.org/greek-mythology-ontology#FemaleValue"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/greek-mythology-ontology#Anteros -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Anteros">
        <rdf:type rdf:resource="http://example.org/greek-mythology-ontology#Deity"/>
        <hasGender rdf:resource="http://example.org/greek-mythology-ontology#MaleValue"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Aphrodite"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Ares"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/greek-mythology-ontology#Apate -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Apate">
        <rdf:type rdf:resource="http://example.org/greek-mythology-ontology#Deity"/>
        <hasGender rdf:resource="http://example.org/greek-mythology-ontology#FemaleValue"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Nyx"/>
        <hasDomain>Deceit</hasDomain>
    </owl:NamedIndividual>
    


    <!-- http://example.org/greek-mythology-ontology#Aphrodite -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Aphrodite">
        <rdf:type rdf:resource="http://example.org/greek-mythology-ontology#Olympian"/>
        <hasGender rdf:resource="http://example.org/greek-mythology-ontology#FemaleValue"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Dione"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Zeus"/>
        <rdfs:comment xml:lang="id">Catatan [2] pada bagan: versi anak Zeus dan Dione. Versi lahir dari Uranus adalah Aphrodite_Uranus.</rdfs:comment>
        <rdfs:label xml:lang="id">Aphrodite (anak Zeus dan Dione)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/greek-mythology-ontology#Aphrodite_Uranus -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Aphrodite_Uranus">
        <rdf:type rdf:resource="http://example.org/greek-mythology-ontology#Olympian"/>
        <hasGender rdf:resource="http://example.org/greek-mythology-ontology#FemaleValue"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Uranus"/>
        <rdfs:comment xml:lang="id">Catatan [2] pada bagan: versi Hesiod, Aphrodite lahir dari Uranus. Versi lain (anak Zeus dan Dione) adalah individu Aphrodite.</rdfs:comment>
        <rdfs:label xml:lang="id">Aphrodite (lahir dari Uranus)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/greek-mythology-ontology#Apollo -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Apollo">
        <rdf:type rdf:resource="http://example.org/greek-mythology-ontology#Olympian"/>
        <hasGender rdf:resource="http://example.org/greek-mythology-ontology#MaleValue"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Leto"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Zeus"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/greek-mythology-ontology#Ares -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Ares">
        <rdf:type rdf:resource="http://example.org/greek-mythology-ontology#Olympian"/>
        <hasGender rdf:resource="http://example.org/greek-mythology-ontology#MaleValue"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Hera"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Zeus"/>
        <hasPartner rdf:resource="http://example.org/greek-mythology-ontology#Aphrodite"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/greek-mythology-ontology#Artemis -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Artemis">
