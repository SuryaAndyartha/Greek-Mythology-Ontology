     -->

    


    <!-- http://example.org/greek-mythology-ontology#ChildOfTitan -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#ChildOfTitan">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#MythicalBeing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/greek-mythology-ontology#hasParent"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/greek-mythology-ontology#Titan"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="id">Anak dari Titan</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#ChildOfZeus -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#ChildOfZeus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#MythicalBeing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/greek-mythology-ontology#hasParent"/>
                        <owl:hasValue rdf:resource="http://example.org/greek-mythology-ontology#Zeus"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="id">Anak Zeus</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Deity -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Deity">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <owl:disjointWith rdf:resource="http://example.org/greek-mythology-ontology#Mortal"/>
        <rdfs:label xml:lang="id">Dewa/Dewi</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Demigod -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Demigod">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#MythicalBeing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/greek-mythology-ontology#hasParent"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/greek-mythology-ontology#Deity"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/greek-mythology-ontology#hasParent"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/greek-mythology-ontology#Mortal"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="id">Setengah Dewa</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#DivineGroup -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#DivineGroup">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <owl:disjointWith rdf:resource="http://example.org/greek-mythology-ontology#FemaleBeing"/>
        <owl:disjointWith rdf:resource="http://example.org/greek-mythology-ontology#MaleBeing"/>
        <rdfs:label xml:lang="id">Kelompok Ilahi</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Female -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Female">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#Gender"/>
        <rdfs:label xml:lang="id">Perempuan</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#FemaleBeing -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#FemaleBeing">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#MythicalBeing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/greek-mythology-ontology#hasGender"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/greek-mythology-ontology#Female"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="id">Makhluk Perempuan</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#FirstGenerationTitan -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#FirstGenerationTitan">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#Titan"/>
        <rdfs:comment xml:lang="id">Dua belas Titan anak Uranus dan Gaia (kotak hijau pada bagan).</rdfs:comment>
        <rdfs:label xml:lang="id">Titan Generasi Pertama</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Gender -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Gender">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#Female"/>
                    <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#Genderless"/>
                    <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#Male"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:label xml:lang="id">Gender</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Genderless -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Genderless">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#Gender"/>
        <rdfs:label xml:lang="id">Tanpa Gender</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#GenderlessBeing -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#GenderlessBeing">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#MythicalBeing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/greek-mythology-ontology#hasGender"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/greek-mythology-ontology#Genderless"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="id">Makhluk Tanpa Gender</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#God -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#God">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#Deity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/greek-mythology-ontology#hasGender"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/greek-mythology-ontology#Male"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="id">Dewa</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Goddess -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Goddess">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#Deity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/greek-mythology-ontology#hasGender"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/greek-mythology-ontology#Female"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="id">Dewi</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Male -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Male">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#Gender"/>
        <rdfs:label xml:lang="id">Laki-laki</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#MaleBeing -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#MaleBeing">
        <owl:equivalentClass>
            <owl:Class>
