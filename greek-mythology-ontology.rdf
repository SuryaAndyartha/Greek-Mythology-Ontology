                    <rdf:Description rdf:about="http://example.org/greek-mythology-ontology#MythicalBeing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://example.org/greek-mythology-ontology#hasGender"/>
                        <owl:someValuesFrom rdf:resource="http://example.org/greek-mythology-ontology#Male"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="id">Makhluk Laki-laki</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Monster -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Monster">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:label xml:lang="id">Monster</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Mortal -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Mortal">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#MythicalBeing"/>
        <rdfs:label xml:lang="id">Manusia Fana</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#MythicalBeing -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#MythicalBeing">
        <rdfs:label xml:lang="id">Makhluk Mitologi</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Oceanid -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Oceanid">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#Deity"/>
        <rdfs:comment xml:lang="id">Anggota kelompok Oceanids pada bagan (Inachus, Melia, Clymene, Pleione).</rdfs:comment>
        <rdfs:label xml:lang="id">Oceanid</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Olympian -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Olympian">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#Deity"/>
        <rdfs:label xml:lang="id">Olympian</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Pleiad -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Pleiad">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#Deity"/>
        <rdfs:comment xml:lang="id">Anggota kelompok Pleiades pada bagan (Maia, Dryope).</rdfs:comment>
        <rdfs:label xml:lang="id">Pleiad</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#PrimordialDeity -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#PrimordialDeity">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#Deity"/>
        <rdfs:label xml:lang="id">Dewa Primordial</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/greek-mythology-ontology#Titan -->

    <owl:Class rdf:about="http://example.org/greek-mythology-ontology#Titan">
        <rdfs:subClassOf rdf:resource="http://example.org/greek-mythology-ontology#Deity"/>
        <rdfs:label xml:lang="id">Titan</rdfs:label>
    </owl:Class>
    


