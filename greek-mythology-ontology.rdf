    <!-- http://example.org/greek-mythology-ontology#Chaos -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Chaos">
        <rdf:type rdf:resource="http://example.org/greek-mythology-ontology#PrimordialDeity"/>
        <hasGender rdf:resource="http://example.org/greek-mythology-ontology#GenderlessValue"/>
