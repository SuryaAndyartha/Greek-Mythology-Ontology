        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Zeus"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/greek-mythology-ontology#Atlas -->

    <owl:NamedIndividual rdf:about="http://example.org/greek-mythology-ontology#Atlas">
        <rdf:type rdf:resource="http://example.org/greek-mythology-ontology#Titan"/>
        <hasGender rdf:resource="http://example.org/greek-mythology-ontology#MaleValue"/>
        <hasParent rdf:resource="http://example.org/greek-mythology-ontology#Iapetus"/>
