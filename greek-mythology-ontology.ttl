#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( greek-mythology-ontology:Female
                greek-mythology-ontology:Genderless
                greek-mythology-ontology:Male
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( greek-mythology-ontology:Olympian
                greek-mythology-ontology:PrimordialDeity
                greek-mythology-ontology:Titan
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( greek-mythology-ontology:Aether
                        greek-mythology-ontology:Alcmene
                        greek-mythology-ontology:Anteros
                        greek-mythology-ontology:Apate
                        greek-mythology-ontology:Aphrodite
                        greek-mythology-ontology:Aphrodite_Uranus
                        greek-mythology-ontology:Apollo
