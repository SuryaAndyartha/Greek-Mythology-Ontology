                        greek-mythology-ontology:Atlas
                        greek-mythology-ontology:Chaos
                        greek-mythology-ontology:Clymene
                        greek-mythology-ontology:Coeus
                        greek-mythology-ontology:Crius
                        greek-mythology-ontology:Cronus
                        greek-mythology-ontology:Cyclopes
                        greek-mythology-ontology:Deimos
                        greek-mythology-ontology:Demeter
                        greek-mythology-ontology:Dione
                        greek-mythology-ontology:Dionysus
                        greek-mythology-ontology:Dryope
                        greek-mythology-ontology:Echidna
                        greek-mythology-ontology:Eileithyia
                        greek-mythology-ontology:Enyo
                        greek-mythology-ontology:Eos
                        greek-mythology-ontology:Epaphus
                        greek-mythology-ontology:Epimetheus
                        greek-mythology-ontology:Erebus
                        greek-mythology-ontology:Erinyes
                        greek-mythology-ontology:Eris
                        greek-mythology-ontology:Eros_Primordial
                        greek-mythology-ontology:Eros_Son
                        greek-mythology-ontology:Eunomia
                        greek-mythology-ontology:FemaleValue
                        greek-mythology-ontology:Gaia
                        greek-mythology-ontology:GenderlessValue
