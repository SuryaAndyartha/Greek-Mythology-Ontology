@prefix : <http://example.org/greek-mythology-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix greek-mythology-ontology: <http://example.org/greek-mythology-ontology#> .
@base <http://example.org/greek-mythology-ontology#> .

<http://example.org/greek-mythology-ontology> rdf:type owl:Ontology ;
                                               rdfs:comment "Dimodelkan dari bagan family tree mitologi Yunani. Hanya hasParent, hasPartner, hasSpouse, dan hasGender yang didefinisikan eksplisit; sisanya disimpulkan reasoner (Pellet)."@id ;
                                               rdfs:label "Ontologi Silsilah Dewa-Dewi Yunani"@id .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/greek-mythology-ontology#hasAncestor
greek-mythology-ontology:hasAncestor rdf:type owl:ObjectProperty ;
                                     owl:inverseOf greek-mythology-ontology:hasDescendant ;
                                     rdf:type owl:TransitiveProperty ;
                                     rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                     rdfs:range greek-mythology-ontology:MythicalBeing ;
                                     rdfs:label "punya leluhur"@id .


###  http://example.org/greek-mythology-ontology#hasAunt
greek-mythology-ontology:hasAunt rdf:type owl:ObjectProperty ;
                                 rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                 rdfs:range greek-mythology-ontology:FemaleBeing ;
                                 owl:propertyChainAxiom ( greek-mythology-ontology:hasParent
                                                          greek-mythology-ontology:hasSister
                                                        ) ;
                                 rdfs:label "punya bibi"@id .


###  http://example.org/greek-mythology-ontology#hasBrother
greek-mythology-ontology:hasBrother rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf greek-mythology-ontology:hasSibling ;
                                    rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                    rdfs:range greek-mythology-ontology:MaleBeing ;
                                    rdfs:label "punya saudara laki-laki"@id .


###  http://example.org/greek-mythology-ontology#hasBrotherInLaw
greek-mythology-ontology:hasBrotherInLaw rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf greek-mythology-ontology:hasSiblingInLaw ;
                                         rdfs:range greek-mythology-ontology:MaleBeing ;
                                         owl:propertyChainAxiom ( greek-mythology-ontology:hasSibling
                                                                  greek-mythology-ontology:hasHusband
                                                                ) ,
                                                                ( greek-mythology-ontology:hasSpouse
                                                                  greek-mythology-ontology:hasBrother
                                                                ) ;
                                         rdfs:label "punya ipar laki-laki"@id .


###  http://example.org/greek-mythology-ontology#hasChild
greek-mythology-ontology:hasChild rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf greek-mythology-ontology:hasDescendant ;
                                  owl:inverseOf greek-mythology-ontology:hasParent ;
                                  rdfs:label "punya anak"@id .


###  http://example.org/greek-mythology-ontology#hasChildInLaw
greek-mythology-ontology:hasChildInLaw rdf:type owl:ObjectProperty ;
                                       owl:inverseOf greek-mythology-ontology:hasParentInLaw ;
                                       rdfs:label "punya menantu"@id .


###  http://example.org/greek-mythology-ontology#hasCousin
greek-mythology-ontology:hasCousin rdf:type owl:ObjectProperty ,
                                            owl:SymmetricProperty ,
                                            owl:IrreflexiveProperty ;
                                   rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                   rdfs:range greek-mythology-ontology:MythicalBeing ;
                                   rdfs:label "punya sepupu"@id .


###  http://example.org/greek-mythology-ontology#hasDaughter
greek-mythology-ontology:hasDaughter rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf greek-mythology-ontology:hasChild ;
                                     rdfs:range greek-mythology-ontology:FemaleBeing ;
                                     rdfs:label "punya anak perempuan"@id .


###  http://example.org/greek-mythology-ontology#hasDaughterInLaw
greek-mythology-ontology:hasDaughterInLaw rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf greek-mythology-ontology:hasChildInLaw ;
                                          rdfs:range greek-mythology-ontology:FemaleBeing ;
                                          owl:propertyChainAxiom ( greek-mythology-ontology:hasChild
                                                                   greek-mythology-ontology:hasWife
                                                                 ) ;
                                          rdfs:label "punya menantu perempuan"@id .


###  http://example.org/greek-mythology-ontology#hasDescendant
greek-mythology-ontology:hasDescendant rdf:type owl:ObjectProperty ;
                                       rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                       rdfs:range greek-mythology-ontology:MythicalBeing ;
                                       rdfs:label "punya keturunan"@id .


###  http://example.org/greek-mythology-ontology#hasFather
greek-mythology-ontology:hasFather rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf greek-mythology-ontology:hasParent ;
                                   rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                   rdfs:range greek-mythology-ontology:MaleBeing ;
                                   rdfs:label "punya ayah"@id .


###  http://example.org/greek-mythology-ontology#hasFatherInLaw
greek-mythology-ontology:hasFatherInLaw rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf greek-mythology-ontology:hasParentInLaw ;
                                        rdfs:range greek-mythology-ontology:MaleBeing ;
                                        owl:propertyChainAxiom ( greek-mythology-ontology:hasSpouse
                                                                 greek-mythology-ontology:hasFather
                                                               ) ;
                                        rdfs:label "punya ayah mertua"@id .


###  http://example.org/greek-mythology-ontology#hasGender
greek-mythology-ontology:hasGender rdf:type owl:ObjectProperty ,
                                            owl:FunctionalProperty ;
                                   rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                   rdfs:range greek-mythology-ontology:Gender ;
                                   rdfs:label "punya gender"@id .


###  http://example.org/greek-mythology-ontology#hasGrandchild
greek-mythology-ontology:hasGrandchild rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf greek-mythology-ontology:hasDescendant ;
                                       owl:inverseOf greek-mythology-ontology:hasGrandparent ;
                                       rdfs:label "punya cucu"@id .


###  http://example.org/greek-mythology-ontology#hasGranddaughter
greek-mythology-ontology:hasGranddaughter rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf greek-mythology-ontology:hasGrandchild ;
                                          rdfs:range greek-mythology-ontology:FemaleBeing ;
                                          owl:propertyChainAxiom ( greek-mythology-ontology:hasChild
                                                                   greek-mythology-ontology:hasDaughter
                                                                 ) ;
                                          rdfs:label "punya cucu perempuan"@id .


###  http://example.org/greek-mythology-ontology#hasGrandfather
greek-mythology-ontology:hasGrandfather rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf greek-mythology-ontology:hasGrandparent ;
                                        rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                        rdfs:range greek-mythology-ontology:MaleBeing ;
                                        owl:propertyChainAxiom ( greek-mythology-ontology:hasParent
                                                                 greek-mythology-ontology:hasFather
                                                               ) ;
                                        rdfs:label "punya kakek"@id .


###  http://example.org/greek-mythology-ontology#hasGrandmother
greek-mythology-ontology:hasGrandmother rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf greek-mythology-ontology:hasGrandparent ;
                                        rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                        rdfs:range greek-mythology-ontology:FemaleBeing ;
                                        owl:propertyChainAxiom ( greek-mythology-ontology:hasParent
                                                                 greek-mythology-ontology:hasMother
                                                               ) ;
                                        rdfs:label "punya nenek"@id .


###  http://example.org/greek-mythology-ontology#hasGrandparent
greek-mythology-ontology:hasGrandparent rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf greek-mythology-ontology:hasAncestor ;
                                        rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                        rdfs:range greek-mythology-ontology:MythicalBeing ;
                                        owl:propertyChainAxiom ( greek-mythology-ontology:hasParent
                                                                 greek-mythology-ontology:hasParent
                                                               ) ;
                                        rdfs:label "punya kakek/nenek"@id .


###  http://example.org/greek-mythology-ontology#hasGrandson
greek-mythology-ontology:hasGrandson rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf greek-mythology-ontology:hasGrandchild ;
                                     rdfs:range greek-mythology-ontology:MaleBeing ;
                                     owl:propertyChainAxiom ( greek-mythology-ontology:hasChild
                                                              greek-mythology-ontology:hasSon
                                                            ) ;
                                     rdfs:label "punya cucu laki-laki"@id .


###  http://example.org/greek-mythology-ontology#hasHusband
greek-mythology-ontology:hasHusband rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf greek-mythology-ontology:hasSpouse ;
                                    owl:inverseOf greek-mythology-ontology:hasWife ;
                                    rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                    rdfs:range greek-mythology-ontology:MaleBeing ;
                                    rdfs:label "punya suami"@id .


###  http://example.org/greek-mythology-ontology#hasMother
greek-mythology-ontology:hasMother rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf greek-mythology-ontology:hasParent ;
                                   rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                   rdfs:range greek-mythology-ontology:FemaleBeing ;
                                   rdfs:label "punya ibu"@id .


###  http://example.org/greek-mythology-ontology#hasMotherInLaw
greek-mythology-ontology:hasMotherInLaw rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf greek-mythology-ontology:hasParentInLaw ;
                                        rdfs:range greek-mythology-ontology:FemaleBeing ;
                                        owl:propertyChainAxiom ( greek-mythology-ontology:hasSpouse
                                                                 greek-mythology-ontology:hasMother
                                                               ) ;
                                        rdfs:label "punya ibu mertua"@id .


###  http://example.org/greek-mythology-ontology#hasNephew
greek-mythology-ontology:hasNephew rdf:type owl:ObjectProperty ;
                                   rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                   rdfs:range greek-mythology-ontology:MaleBeing ;
                                   owl:propertyChainAxiom ( greek-mythology-ontology:hasSibling
                                                            greek-mythology-ontology:hasSon
                                                          ) ;
                                   rdfs:label "punya keponakan laki-laki"@id .


###  http://example.org/greek-mythology-ontology#hasNiece
greek-mythology-ontology:hasNiece rdf:type owl:ObjectProperty ;
                                  rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                  rdfs:range greek-mythology-ontology:FemaleBeing ;
                                  owl:propertyChainAxiom ( greek-mythology-ontology:hasSibling
                                                           greek-mythology-ontology:hasDaughter
                                                         ) ;
                                  rdfs:label "punya keponakan perempuan"@id .


###  http://example.org/greek-mythology-ontology#hasParent
greek-mythology-ontology:hasParent rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf greek-mythology-ontology:hasAncestor ;
                                   rdf:type owl:AsymmetricProperty ,
                                            owl:IrreflexiveProperty ;
                                   rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                   rdfs:range greek-mythology-ontology:MythicalBeing ;
                                   rdfs:label "punya orang tua"@id .


###  http://example.org/greek-mythology-ontology#hasParentInLaw
greek-mythology-ontology:hasParentInLaw rdf:type owl:ObjectProperty ;
                                        rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                        rdfs:range greek-mythology-ontology:MythicalBeing ;
                                        owl:propertyChainAxiom ( greek-mythology-ontology:hasSpouse
                                                                 greek-mythology-ontology:hasParent
                                                               ) ;
                                        rdfs:label "punya mertua"@id .


###  http://example.org/greek-mythology-ontology#hasPartner
greek-mythology-ontology:hasPartner rdf:type owl:ObjectProperty ,
                                             owl:SymmetricProperty ;
                                    rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                    rdfs:range greek-mythology-ontology:MythicalBeing ;
                                    rdfs:label "punya pasangan"@id .


###  http://example.org/greek-mythology-ontology#hasSibling
greek-mythology-ontology:hasSibling rdf:type owl:ObjectProperty ,
                                             owl:SymmetricProperty ;
                                    rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                    rdfs:range greek-mythology-ontology:MythicalBeing ;
                                    rdfs:label "punya saudara"@id .


###  http://example.org/greek-mythology-ontology#hasSiblingInLaw
greek-mythology-ontology:hasSiblingInLaw rdf:type owl:ObjectProperty ,
                                                  owl:SymmetricProperty ;
                                         rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                         rdfs:range greek-mythology-ontology:MythicalBeing ;
                                         owl:propertyChainAxiom ( greek-mythology-ontology:hasSpouse
                                                                  greek-mythology-ontology:hasSibling
                                                                ) ;
                                         rdfs:label "punya ipar"@id .


###  http://example.org/greek-mythology-ontology#hasSister
greek-mythology-ontology:hasSister rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf greek-mythology-ontology:hasSibling ;
                                   rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                   rdfs:range greek-mythology-ontology:FemaleBeing ;
                                   rdfs:label "punya saudara perempuan"@id .


###  http://example.org/greek-mythology-ontology#hasSisterInLaw
greek-mythology-ontology:hasSisterInLaw rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf greek-mythology-ontology:hasSiblingInLaw ;
                                        rdfs:range greek-mythology-ontology:FemaleBeing ;
                                        owl:propertyChainAxiom ( greek-mythology-ontology:hasSibling
                                                                 greek-mythology-ontology:hasWife
                                                               ) ,
                                                               ( greek-mythology-ontology:hasSpouse
                                                                 greek-mythology-ontology:hasSister
                                                               ) ;
                                        rdfs:label "punya ipar perempuan"@id .


###  http://example.org/greek-mythology-ontology#hasSon
greek-mythology-ontology:hasSon rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf greek-mythology-ontology:hasChild ;
                                rdfs:range greek-mythology-ontology:MaleBeing ;
                                rdfs:label "punya anak laki-laki"@id .


###  http://example.org/greek-mythology-ontology#hasSonInLaw
greek-mythology-ontology:hasSonInLaw rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf greek-mythology-ontology:hasChildInLaw ;
                                     rdfs:range greek-mythology-ontology:MaleBeing ;
                                     owl:propertyChainAxiom ( greek-mythology-ontology:hasChild
                                                              greek-mythology-ontology:hasHusband
                                                            ) ;
                                     rdfs:label "punya menantu laki-laki"@id .


###  http://example.org/greek-mythology-ontology#hasSpouse
greek-mythology-ontology:hasSpouse rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf greek-mythology-ontology:hasPartner ;
                                   rdf:type owl:SymmetricProperty ;
                                   rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                   rdfs:range greek-mythology-ontology:MythicalBeing ;
                                   rdfs:label "punya pasangan sah/pernikahan"@id .


###  http://example.org/greek-mythology-ontology#hasUncle
greek-mythology-ontology:hasUncle rdf:type owl:ObjectProperty ;
                                  rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                  rdfs:range greek-mythology-ontology:MaleBeing ;
                                  owl:propertyChainAxiom ( greek-mythology-ontology:hasParent
                                                           greek-mythology-ontology:hasBrother
                                                         ) ;
                                  rdfs:label "punya paman"@id .


###  http://example.org/greek-mythology-ontology#hasWife
greek-mythology-ontology:hasWife rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf greek-mythology-ontology:hasSpouse ;
                                 rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                 rdfs:range greek-mythology-ontology:FemaleBeing ;
                                 rdfs:label "punya istri"@id .


#################################################################
#    Data properties
#################################################################

###  http://example.org/greek-mythology-ontology#hasDomain
greek-mythology-ontology:hasDomain rdf:type owl:DatatypeProperty ;
                                   rdfs:domain greek-mythology-ontology:MythicalBeing ;
                                   rdfs:range xsd:string ;
                                   rdfs:label "punya ranah/personifikasi"@id .


#################################################################
#    Classes
#################################################################

###  http://example.org/greek-mythology-ontology#ChildOfTitan
greek-mythology-ontology:ChildOfTitan rdf:type owl:Class ;
                                      owl:equivalentClass [ owl:intersectionOf ( greek-mythology-ontology:MythicalBeing
                                                                                 [ rdf:type owl:Restriction ;
                                                                                   owl:onProperty greek-mythology-ontology:hasParent ;
                                                                                   owl:someValuesFrom greek-mythology-ontology:Titan
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ] ;
                                      rdfs:label "Anak dari Titan"@id .


###  http://example.org/greek-mythology-ontology#ChildOfZeus
greek-mythology-ontology:ChildOfZeus rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( greek-mythology-ontology:MythicalBeing
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty greek-mythology-ontology:hasParent ;
                                                                                  owl:hasValue greek-mythology-ontology:Zeus
                                                                                ]
                                                                              ) ;
                                                           rdf:type owl:Class
                                                         ] ;
                                     rdfs:label "Anak Zeus"@id .


###  http://example.org/greek-mythology-ontology#Deity
greek-mythology-ontology:Deity rdf:type owl:Class ;
                               rdfs:subClassOf greek-mythology-ontology:MythicalBeing ;
                               owl:disjointWith greek-mythology-ontology:Mortal ;
                               rdfs:label "Dewa/Dewi"@id .


###  http://example.org/greek-mythology-ontology#Demigod
greek-mythology-ontology:Demigod rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( greek-mythology-ontology:MythicalBeing
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty greek-mythology-ontology:hasParent ;
                                                                              owl:someValuesFrom greek-mythology-ontology:Deity
                                                                            ]
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty greek-mythology-ontology:hasParent ;
                                                                              owl:someValuesFrom greek-mythology-ontology:Mortal
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:label "Setengah Dewa"@id .


###  http://example.org/greek-mythology-ontology#DivineGroup
greek-mythology-ontology:DivineGroup rdf:type owl:Class ;
                                     rdfs:subClassOf greek-mythology-ontology:MythicalBeing ;
                                     owl:disjointWith greek-mythology-ontology:FemaleBeing ,
                                                      greek-mythology-ontology:MaleBeing ;
                                     rdfs:label "Kelompok Ilahi"@id .


###  http://example.org/greek-mythology-ontology#Female
greek-mythology-ontology:Female rdf:type owl:Class ;
                                rdfs:subClassOf greek-mythology-ontology:Gender ;
                                rdfs:label "Perempuan"@id .


###  http://example.org/greek-mythology-ontology#FemaleBeing
greek-mythology-ontology:FemaleBeing rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( greek-mythology-ontology:MythicalBeing
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty greek-mythology-ontology:hasGender ;
                                                                                  owl:someValuesFrom greek-mythology-ontology:Female
                                                                                ]
                                                                              ) ;
                                                           rdf:type owl:Class
                                                         ] ;
                                     rdfs:label "Makhluk Perempuan"@id .


###  http://example.org/greek-mythology-ontology#FirstGenerationTitan
greek-mythology-ontology:FirstGenerationTitan rdf:type owl:Class ;
                                              rdfs:subClassOf greek-mythology-ontology:Titan ;
                                              rdfs:comment "Dua belas Titan anak Uranus dan Gaia (kotak hijau pada bagan)."@id ;
                                              rdfs:label "Titan Generasi Pertama"@id .


###  http://example.org/greek-mythology-ontology#Gender
greek-mythology-ontology:Gender rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Class ;
                                                      owl:unionOf ( greek-mythology-ontology:Female
                                                                    greek-mythology-ontology:Genderless
                                                                    greek-mythology-ontology:Male
                                                                  )
                                                    ] ;
                                owl:disjointWith greek-mythology-ontology:MythicalBeing ;
                                rdfs:label "Gender"@id .


###  http://example.org/greek-mythology-ontology#Genderless
greek-mythology-ontology:Genderless rdf:type owl:Class ;
                                    rdfs:subClassOf greek-mythology-ontology:Gender ;
                                    rdfs:label "Tanpa Gender"@id .


###  http://example.org/greek-mythology-ontology#GenderlessBeing
greek-mythology-ontology:GenderlessBeing rdf:type owl:Class ;
                                         owl:equivalentClass [ owl:intersectionOf ( greek-mythology-ontology:MythicalBeing
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty greek-mythology-ontology:hasGender ;
                                                                                      owl:someValuesFrom greek-mythology-ontology:Genderless
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ] ;
                                         rdfs:label "Makhluk Tanpa Gender"@id .


###  http://example.org/greek-mythology-ontology#God
greek-mythology-ontology:God rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( greek-mythology-ontology:Deity
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty greek-mythology-ontology:hasGender ;
                                                                          owl:someValuesFrom greek-mythology-ontology:Male
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             rdfs:label "Dewa"@id .


###  http://example.org/greek-mythology-ontology#Goddess
greek-mythology-ontology:Goddess rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( greek-mythology-ontology:Deity
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty greek-mythology-ontology:hasGender ;
                                                                              owl:someValuesFrom greek-mythology-ontology:Female
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:label "Dewi"@id .


###  http://example.org/greek-mythology-ontology#Male
greek-mythology-ontology:Male rdf:type owl:Class ;
                              rdfs:subClassOf greek-mythology-ontology:Gender ;
                              rdfs:label "Laki-laki"@id .


###  http://example.org/greek-mythology-ontology#MaleBeing
greek-mythology-ontology:MaleBeing rdf:type owl:Class ;
                                   owl:equivalentClass [ owl:intersectionOf ( greek-mythology-ontology:MythicalBeing
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty greek-mythology-ontology:hasGender ;
                                                                                owl:someValuesFrom greek-mythology-ontology:Male
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ] ;
                                   rdfs:label "Makhluk Laki-laki"@id .


