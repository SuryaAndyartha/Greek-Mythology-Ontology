<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/greek-mythology-ontology#"
     xml:base="http://example.org/greek-mythology-ontology"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#">
    <owl:Ontology rdf:about="http://example.org/greek-mythology-ontology">
        <rdfs:label xml:lang="id">Ontologi Silsilah Dewa-Dewi Yunani</rdfs:label>
        <rdfs:comment xml:lang="id">Dimodelkan dari bagan family tree mitologi Yunani. Hanya hasParent, hasPartner, hasSpouse, dan hasGender yang didefinisikan eksplisit; sisanya disimpulkan reasoner (Pellet).</rdfs:comment>
    </owl:Ontology>

    <!-- =========================================================== -->
    <!-- OBJECT PROPERTIES                                           -->
    <!-- =========================================================== -->

    <!-- Untuk kebutuhan gender -->
    <owl:ObjectProperty rdf:about="#hasGender">
        <rdfs:label xml:lang="id">punya gender</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#Gender"/>
    </owl:ObjectProperty>

    <!-- Untuk keperluan punya orang tua -->
    <owl:ObjectProperty rdf:about="#hasParent">
        <rdfs:label xml:lang="id">punya orang tua</rdfs:label>
        <owl:inverseOf rdf:resource="#hasChild"/>
        <rdfs:subPropertyOf rdf:resource="#hasAncestor"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MythicalBeing"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasFather">
        <rdfs:label xml:lang="id">punya ayah</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasParent"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MaleBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasMother">
        <rdfs:label xml:lang="id">punya ibu</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasParent"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#FemaleBeing"/>
    </owl:ObjectProperty>

    <!-- Untuk keperluan punya anak -->
    <owl:ObjectProperty rdf:about="#hasChild">
        <rdfs:label xml:lang="id">punya anak</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasDescendant"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasSon">
        <rdfs:label xml:lang="id">punya anak laki-laki</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasChild"/>
        <rdfs:range rdf:resource="#MaleBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasDaughter">
        <rdfs:label xml:lang="id">punya anak perempuan</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasChild"/>
        <rdfs:range rdf:resource="#FemaleBeing"/>
    </owl:ObjectProperty>

    <!-- ObjProp di atas Parent dan Child -->
    <owl:ObjectProperty rdf:about="#hasAncestor">
        <rdfs:label xml:lang="id">punya leluhur</rdfs:label>
        <owl:inverseOf rdf:resource="#hasDescendant"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MythicalBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasDescendant">
        <rdfs:label xml:lang="id">punya keturunan</rdfs:label>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MythicalBeing"/>
    </owl:ObjectProperty>

    <!-- Untuk kebutuhan pasangan hidup -->
    <owl:ObjectProperty rdf:about="#hasPartner">
        <rdfs:label xml:lang="id">punya pasangan</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MythicalBeing"/>
    </owl:ObjectProperty>
    <!-- Sebagian besar hubungan asmara tidak melalui pernikahan resmi -->
    <owl:ObjectProperty rdf:about="#hasSpouse">
        <rdfs:label xml:lang="id">punya pasangan sah/pernikahan</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasPartner"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MythicalBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasHusband">
        <rdfs:label xml:lang="id">punya suami</rdfs:label>
        <owl:inverseOf rdf:resource="#hasWife"/>
        <rdfs:subPropertyOf rdf:resource="#hasSpouse"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MaleBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasWife">
        <rdfs:label xml:lang="id">punya istri</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasSpouse"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#FemaleBeing"/>
    </owl:ObjectProperty>

    <!-- Untuk kebutuhan saudara -->
    <owl:ObjectProperty rdf:about="#hasSibling">
        <rdfs:label xml:lang="id">punya saudara</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MythicalBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasBrother">
        <rdfs:label xml:lang="id">punya saudara laki-laki</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasSibling"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MaleBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasSister">
        <rdfs:label xml:lang="id">punya saudara perempuan</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasSibling"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#FemaleBeing"/>
    </owl:ObjectProperty>

    <!-- Untuk kebutuhan kakek/nenek -->
    <owl:ObjectProperty rdf:about="#hasGrandparent">
        <rdfs:label xml:lang="id">punya kakek/nenek</rdfs:label>
        <owl:inverseOf rdf:resource="#hasGrandchild"/>
        <rdfs:subPropertyOf rdf:resource="#hasAncestor"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasParent"/>
            <rdf:Description rdf:about="#hasParent"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MythicalBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasGrandfather">
        <rdfs:label xml:lang="id">punya kakek</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasGrandparent"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasParent"/>
            <rdf:Description rdf:about="#hasFather"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MaleBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasGrandmother">
        <rdfs:label xml:lang="id">punya nenek</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasGrandparent"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasParent"/>
            <rdf:Description rdf:about="#hasMother"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#FemaleBeing"/>
    </owl:ObjectProperty>

    <!-- Untuk kebutuhan cucu -->
    <owl:ObjectProperty rdf:about="#hasGrandchild">
        <rdfs:label xml:lang="id">punya cucu</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasDescendant"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasGrandson">
        <rdfs:label xml:lang="id">punya cucu laki-laki</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasGrandchild"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasChild"/>
            <rdf:Description rdf:about="#hasSon"/>
        </owl:propertyChainAxiom>
        <rdfs:range rdf:resource="#MaleBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasGranddaughter">
        <rdfs:label xml:lang="id">punya cucu perempuan</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasGrandchild"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasChild"/>
            <rdf:Description rdf:about="#hasDaughter"/>
        </owl:propertyChainAxiom>
        <rdfs:range rdf:resource="#FemaleBeing"/>
    </owl:ObjectProperty>

    <!-- Untuk kebutuhan paman/bibi -->
    <owl:ObjectProperty rdf:about="#hasUncle">
        <rdfs:label xml:lang="id">punya paman</rdfs:label>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasParent"/>
            <rdf:Description rdf:about="#hasBrother"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MaleBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasAunt">
        <rdfs:label xml:lang="id">punya bibi</rdfs:label>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasParent"/>
            <rdf:Description rdf:about="#hasSister"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#FemaleBeing"/>
    </owl:ObjectProperty>

    <!-- Untuk kebutuhan keponakan -->
    <owl:ObjectProperty rdf:about="#hasNiece">
        <rdfs:label xml:lang="id">punya keponakan perempuan</rdfs:label>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasSibling"/>
            <rdf:Description rdf:about="#hasDaughter"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#FemaleBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasNephew">
        <rdfs:label xml:lang="id">punya keponakan laki-laki</rdfs:label>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasSibling"/>
            <rdf:Description rdf:about="#hasSon"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MaleBeing"/>
    </owl:ObjectProperty>

    <!-- Untuk kebutuhan saudara sepupu -->
    <!-- Sengaja tanpa chain: chain parent-sibling-child membuat individu bisa menjadi sepupu dirinya sendiri karena incest dalam data. Diisi lewat SWRL. -->
    <owl:ObjectProperty rdf:about="#hasCousin">
        <rdfs:label xml:lang="id">punya sepupu</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MythicalBeing"/>
    </owl:ObjectProperty>

    <!-- Untuk kebutuhan mertua -->
    <owl:ObjectProperty rdf:about="#hasParentInLaw">
        <rdfs:label xml:lang="id">punya mertua</rdfs:label>
        <owl:inverseOf rdf:resource="#hasChildInLaw"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasSpouse"/>
            <rdf:Description rdf:about="#hasParent"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MythicalBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasFatherInLaw">
        <rdfs:label xml:lang="id">punya ayah mertua</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasParentInLaw"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasSpouse"/>
            <rdf:Description rdf:about="#hasFather"/>
        </owl:propertyChainAxiom>
        <rdfs:range rdf:resource="#MaleBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasMotherInLaw">
        <rdfs:label xml:lang="id">punya ibu mertua</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasParentInLaw"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasSpouse"/>
            <rdf:Description rdf:about="#hasMother"/>
        </owl:propertyChainAxiom>
        <rdfs:range rdf:resource="#FemaleBeing"/>
    </owl:ObjectProperty>

    <!-- Untuk kebutuhan menantu -->
    <owl:ObjectProperty rdf:about="#hasChildInLaw">
        <rdfs:label xml:lang="id">punya menantu</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasSonInLaw">
        <rdfs:label xml:lang="id">punya menantu laki-laki</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasChildInLaw"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasChild"/>
            <rdf:Description rdf:about="#hasHusband"/>
        </owl:propertyChainAxiom>
        <rdfs:range rdf:resource="#MaleBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasDaughterInLaw">
        <rdfs:label xml:lang="id">punya menantu perempuan</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasChildInLaw"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasChild"/>
            <rdf:Description rdf:about="#hasWife"/>
        </owl:propertyChainAxiom>
        <rdfs:range rdf:resource="#FemaleBeing"/>
    </owl:ObjectProperty>

    <!-- Untuk kebutuhan ipar -->
    <owl:ObjectProperty rdf:about="#hasSiblingInLaw">
        <rdfs:label xml:lang="id">punya ipar</rdfs:label>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasSpouse"/>
            <rdf:Description rdf:about="#hasSibling"/>
        </owl:propertyChainAxiom>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="#MythicalBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasBrotherInLaw">
        <rdfs:label xml:lang="id">punya ipar laki-laki</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasSiblingInLaw"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasSpouse"/>
            <rdf:Description rdf:about="#hasBrother"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasSibling"/>
            <rdf:Description rdf:about="#hasHusband"/>
        </owl:propertyChainAxiom>
        <rdfs:range rdf:resource="#MaleBeing"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasSisterInLaw">
        <rdfs:label xml:lang="id">punya ipar perempuan</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="#hasSiblingInLaw"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasSpouse"/>
            <rdf:Description rdf:about="#hasSister"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="#hasSibling"/>
            <rdf:Description rdf:about="#hasWife"/>
        </owl:propertyChainAxiom>
        <rdfs:range rdf:resource="#FemaleBeing"/>
    </owl:ObjectProperty>


    <!-- =========================================================== -->
    <!-- DATA PROPERTIES                                             -->
    <!-- =========================================================== -->

    <!-- Ranah/personifikasi, sesuai teks kecil di bawah nama pada bagan -->
    <owl:DatatypeProperty rdf:about="#hasDomain">
        <rdfs:label xml:lang="id">punya ranah/personifikasi</rdfs:label>
        <rdfs:domain rdf:resource="#MythicalBeing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>


    <!-- =========================================================== -->
    <!-- CLASSES                                                     -->
    <!-- =========================================================== -->

    <!-- Kelas puncak -->
    <owl:Class rdf:about="#MythicalBeing">
        <rdfs:label xml:lang="id">Makhluk Mitologi</rdfs:label>
        <owl:disjointWith rdf:resource="#Gender"/>
    </owl:Class>

    <!-- Male/Female/Genderless adalah gender, bukan jenis makhluk -->
    <owl:Class rdf:about="#Gender">
        <rdfs:label xml:lang="id">Gender</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Male"/>
                    <rdf:Description rdf:about="#Female"/>
                    <rdf:Description rdf:about="#Genderless"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Male">
        <rdfs:label xml:lang="id">Laki-laki</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Gender"/>
    </owl:Class>
    <owl:Class rdf:about="#Female">
        <rdfs:label xml:lang="id">Perempuan</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Gender"/>
    </owl:Class>
    <owl:Class rdf:about="#Genderless">
        <rdfs:label xml:lang="id">Tanpa Gender</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Gender"/>
    </owl:Class>
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="#Male"/>
            <rdf:Description rdf:about="#Female"/>
            <rdf:Description rdf:about="#Genderless"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- Makhluk bergender: diturunkan dari nilai gender -->
    <owl:Class rdf:about="#MaleBeing">
        <rdfs:label xml:lang="id">Makhluk Laki-laki</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#MythicalBeing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasGender"/>
                        <owl:someValuesFrom rdf:resource="#Male"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#FemaleBeing">
        <rdfs:label xml:lang="id">Makhluk Perempuan</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#MythicalBeing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasGender"/>
                        <owl:someValuesFrom rdf:resource="#Female"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#GenderlessBeing">
        <rdfs:label xml:lang="id">Makhluk Tanpa Gender</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#MythicalBeing"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasGender"/>
                        <owl:someValuesFrom rdf:resource="#Genderless"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- Kelompok: satu kotak di bagan yang mewakili banyak makhluk tanpa anggota bernama -->
    <owl:Class rdf:about="#DivineGroup">
        <rdfs:label xml:lang="id">Kelompok Ilahi</rdfs:label>
        <rdfs:subClassOf rdf:resource="#MythicalBeing"/>
        <owl:disjointWith rdf:resource="#MaleBeing"/>
        <owl:disjointWith rdf:resource="#FemaleBeing"/>
    </owl:Class>

    <!-- Jenis makhluk -->
    <owl:Class rdf:about="#Deity">
        <rdfs:label xml:lang="id">Dewa/Dewi</rdfs:label>
        <rdfs:subClassOf rdf:resource="#MythicalBeing"/>
        <owl:disjointWith rdf:resource="#Mortal"/>
    </owl:Class>
    <owl:Class rdf:about="#Mortal">
        <rdfs:label xml:lang="id">Manusia Fana</rdfs:label>
        <rdfs:subClassOf rdf:resource="#MythicalBeing"/>
    </owl:Class>
    <owl:Class rdf:about="#Monster">
        <rdfs:label xml:lang="id">Monster</rdfs:label>
        <rdfs:subClassOf rdf:resource="#MythicalBeing"/>
    </owl:Class>

    <!-- Generasi dewa -->
    <owl:Class rdf:about="#PrimordialDeity">
        <rdfs:label xml:lang="id">Dewa Primordial</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Deity"/>
    </owl:Class>
    <owl:Class rdf:about="#Titan">
        <rdfs:label xml:lang="id">Titan</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Deity"/>
    </owl:Class>
    <owl:Class rdf:about="#FirstGenerationTitan">
        <rdfs:label xml:lang="id">Titan Generasi Pertama</rdfs:label>
        <rdfs:comment xml:lang="id">Dua belas Titan anak Uranus dan Gaia (kotak hijau pada bagan).</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Titan"/>
    </owl:Class>
    <owl:Class rdf:about="#Olympian">
        <rdfs:label xml:lang="id">Olympian</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Deity"/>
    </owl:Class>
    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="#PrimordialDeity"/>
            <rdf:Description rdf:about="#Titan"/>
            <rdf:Description rdf:about="#Olympian"/>
        </owl:members>
    </owl:AllDisjointClasses>

    <!-- Keanggotaan kelompok yang anggotanya digambar di bagan -->
    <owl:Class rdf:about="#Oceanid">
        <rdfs:label xml:lang="id">Oceanid</rdfs:label>
        <rdfs:comment xml:lang="id">Anggota kelompok Oceanids pada bagan (Inachus, Melia, Clymene, Pleione).</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Deity"/>
    </owl:Class>
    <owl:Class rdf:about="#Pleiad">
        <rdfs:label xml:lang="id">Pleiad</rdfs:label>
        <rdfs:comment xml:lang="id">Anggota kelompok Pleiades pada bagan (Maia, Dryope).</rdfs:comment>
        <rdfs:subClassOf rdf:resource="#Deity"/>
    </owl:Class>

    <!-- Defined class: diklasifikasikan otomatis oleh reasoner -->
    <owl:Class rdf:about="#God">
        <rdfs:label xml:lang="id">Dewa</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Deity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasGender"/>
                        <owl:someValuesFrom rdf:resource="#Male"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Goddess">
        <rdfs:label xml:lang="id">Dewi</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Deity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasGender"/>
                        <owl:someValuesFrom rdf:resource="#Female"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#Demigod">
