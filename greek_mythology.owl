                        <owl:someValuesFrom rdf:resource="#Mortal"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    <owl:Class rdf:about="#ChildOfTitan">
