        <Literal xml:lang="id">Mengikuti bagan; sumber mitologi lain menyebut orang tua yang berbeda.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
